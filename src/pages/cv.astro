---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV Carlos Gutierrez Caballero</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Iconos SVG -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Librería html2canvas para descargar como imagen -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        
        /* Utilidad para evitar cortes feos de texto entre páginas en el PDF */
        .avoid-break {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        /* Reglas estrictas para forzar el diseño de Escritorio en la Imagen y alta calidad */
        .export-mode { 
            width: 1000px !important; /* Ancho fijo óptimo de escritorio */
            max-width: 1000px !important; 
            margin: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        .export-mode .layout-wrapper { flex-direction: row !important; display: flex !important; }
        .export-mode .sidebar { width: 320px !important; flex-shrink: 0 !important; border-right: 1px solid #f1f5f9 !important; }
        .export-mode .main-content { width: 680px !important; flex-shrink: 0 !important; }
        .export-mode .header-content { flex-direction: row !important; align-items: flex-start !important; text-align: left !important; }

        @media print {
            body { background-color: white; }
            .print-container { box-shadow: none !important; margin: 0 !important; max-width: 100% !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="text-slate-800 antialiased py-4 print:py-0">

