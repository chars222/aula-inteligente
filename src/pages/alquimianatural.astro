                    <div class="mb-8">
                        <span class="text-gray-400 line-through text-2xl font-light">$100.00 USD</span>
                        <div class="text-6xl md:text-7xl font-bold text-brand-sage mt-2">$30.00 <span class="text-2xl">USD</span></div>
                        <p class="text-brand-rose font-bold mt-4 animate-pulse text-sm tracking-widest uppercase">CUPÓN DE 70% APLICADO AUTOMÁTICAMENTE</p>
                    </div>

                    <a href="https://go.hotmart.com/V104688154N?ap=9d09" class="block w-full bg-brand-sage hover:bg-brand-dark text-white py-5 rounded-xl text-xl font-bold shadow-xl transition-all mb-6">
                        INSCRIBIRME AHORA Y RECIBIR LOS BONOS
                    </a>

                    <!-- Garantía Real -->
                    <div class="bg-gray-50 p-6 rounded-xl text-left flex gap-4 items-start border border-gray-100">
                        <span class="text-3xl">🛡️</span>
                        <div>
                            <h4 class="font-bold text-brand-dark">Garantía Hotmart® de 7 Días</h4>
                            <p class="text-sm text-gray-600 mt-1">Tienes 7 días para probar el curso por dentro. Si no supera tus expectativas, te reembolsamos el 100% de tu dinero SIN hacer preguntas. Tu compra es 100% segura.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
