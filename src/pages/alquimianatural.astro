                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Natural</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de avena y miel</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de aloe vera</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de cacao</li>
                    </ul>
                </div>

                <!-- Tarjeta 3 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
