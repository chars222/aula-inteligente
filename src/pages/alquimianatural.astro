    <!-- PREGUNTAS FRECUENTES (FAQ) -->
    <section class="py-20 px-6 bg-white border-t border-gray-100">
        <div class="max-w-3xl mx-auto">
            <h2 class="font-serif text-3xl md:text-4xl text-center mb-12 text-brand-dark">Preguntas Frecuentes</h2>
            
            <div class="space-y-4">
                <!-- FAQ 1 -->
                <details class="group bg-brand-cream p-6 rounded-2xl border border-brand-sage/20 [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex items-center justify-between cursor-pointer font-bold text-brand-dark text-lg">
                        ¿El curso es presencial o en línea?
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                        </span>
                    </summary>
                    <p class="text-gray-600 mt-4 leading-relaxed">
                        Es 100% online. Al inscribirte, recibirás acceso inmediato a la plataforma donde podrás ver las más de 70 clases en video, a tu propio ritmo y las veces que quieras, de por vida.
                    </p>
                </details>

                <!-- FAQ 2 -->
                <details class="group bg-brand-cream p-6 rounded-2xl border border-brand-sage/20 [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex items-center justify-between cursor-pointer font-bold text-brand-dark text-lg">
                        ¿Tendré soporte para resolver mis dudas?
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
