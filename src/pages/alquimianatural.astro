    <!-- SCRIPT DEL TEMPORIZADOR INTELIGENTE (LOCALSTORAGE) -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const DURATION_MS = 15 * 60 * 1000; // 15 minutos en milisegundos
            const display = document.getElementById('countdown');
            const container = document.getElementById('timerContainer');
            const title = document.getElementById('timerTitle');
            const subtitle = document.getElementById('timerSubtitle');
            
            let endTime = localStorage.getItem('alquimia_timer_end');
            const now = new Date().getTime();

            if (!endTime || (now - endTime) > (24 * 60 * 60 * 1000)) {
                endTime = now + DURATION_MS;
                localStorage.setItem('alquimia_timer_end', endTime);
            }

            function updateTimer() {
                const currentTime = new Date().getTime();
                const remainingMs = endTime - currentTime;

                if (remainingMs > 0) {
                    const minutes = Math.floor(remainingMs / (1000 * 60));
                    const seconds = Math.floor((remainingMs % (1000 * 60)) / 1000);
                    display.textContent = `${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                } else {
                    display.textContent = "00:00";
                    display.classList.add('text-red-600', 'animate-pulse');
                    
                    container.classList.remove('bg-green-50', 'border-green-200');
                    container.classList.add('bg-red-50', 'border-red-200');
                    
                    title.classList.remove('text-green-700');
                    title.classList.add('text-red-700');
                    title.innerHTML = '⚠️ Tiempo de reserva agotado <span id="countdown" class="font-mono text-2xl ml-1 tracking-wider text-red-600 animate-pulse">00:00</span>';
                    
                    subtitle.classList.remove('text-green-600');
                    subtitle.classList.add('text-red-600');
                    subtitle.textContent = "Tu cupón podría ser reasignado. Haz clic en 'Inscribirme Ahora' para verificar si el descuento sigue disponible en el checkout.";
                    
                    clearInterval(timerInterval);
                }
            }
            
            updateTimer(); // Llamada inicial
            const timerInterval = setInterval(updateTimer, 1000);
        });
    </script>

