                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Facial</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Desmaquillante piel grasa</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Desmaquillante todo tipo</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Antiarrugas para líneas de expresión</li>
                    </ul>
                </div>

                <!-- Tarjeta 4 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
