                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Exfoliante</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de café (Anticelulitis)</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabones de lufa natural</li>
                    </ul>
                </div>

                <!-- Tarjeta 5 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
                        <img src="https://www.mentesmart.store/jabon-de-lavanda-5.webp" alt="Jabón terapéutico de lavanda" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Terapéutica</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de lavanda (Relajante)</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de romero</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón de eucalipto</li>
                    </ul>
                </div>

                <!-- Tarjeta 6 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
                        <img src="https://www.mentesmart.store/jabon-de-sandia-6.webp" alt="Jabón decorativo diseño sandía" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Decorativa</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón diseño Sandía</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Jabón diseño Vaca</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Diseños para eventos</li>
                    </ul>
                </div>

                <!-- Tarjeta 7 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
                        <img src="https://www.mentesmart.store/jabon-de-canela-7.webp" alt="Jabón esotérico de canela" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Línea Esotérica</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Canela (Abundancia)</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Ruda (Abre caminos)</li>
                    </ul>
                </div>

                <!-- Tarjeta 8 -->
                <div class="bg-white rounded-[2rem] p-6 shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                    <div class="w-32 h-32 mx-auto rounded-full overflow-hidden mb-6 border-4 border-brand-cream shadow-inner group-hover:scale-105 transition-transform">
                        <img src="https://www.mentesmart.store/jabon-de-avena-sopificado-8.webp" alt="Jabón saponificado en frío" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <h3 class="font-serif text-xl text-center text-brand-dark mb-4">Saponificación</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Técnica avanzada en frío</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Avena saponificado</li>
                        <li class="flex gap-2"><span class="text-brand-sage">❯</span> Moringa saponificado</li>
                    </ul>
                </div>

            </div>
            
            <div class="mt-12 text-center">
                 <a href="#oferta" class="inline-block bg-brand-sage hover:bg-brand-dark text-white px-10 py-4 rounded-full text-lg font-bold shadow-xl transition-all transform hover:scale-105">
                    QUIERO APRENDER A HACER ESTOS JABONES
                </a>
            </div>
        </div>
    </section>

    <!-- LA INSTRUCTORA -->
    <section class="bg-brand-cream py-24 px-6 border-y border-brand-sage/20">
        <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 flex justify-center">
                <div class="w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden border-8 border-white shadow-xl bg-gray-200 flex items-center justify-center relative">
                    <img src="https://www.mentesmart.store/experta1.webp" alt="Rocío Díaz, Experta en Jabonería" class="w-full h-full object-cover object-top" loading="lazy" />
                </div>
            </div>
            <div class="order-1 md:order-2">
                <span class="text-brand-sage font-bold tracking-widest uppercase text-sm">Conoce a tu Instructora</span>
                <h2 class="font-serif text-3xl md:text-4xl text-brand-dark mt-2 mb-6">Rocío Díaz</h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    Emprendedora y creadora de jabones artesanales con más de 5 años de experiencia en cosmética natural.
                </p>
                <p class="text-gray-700 leading-relaxed mb-6">
                    "Pasé de ser profesional en el sector logístico a crear un negocio exitoso desde mi casa. Esto transformó mi vida y la de cientos de mis alumnas. Mi misión es ayudarte a descubrir tu potencial, emprender con seguridad y generar ingresos creando jabones que cuidan la piel y el medio ambiente."
                </p>
                <div class="bg-white p-4 rounded-xl border-l-4 border-brand-gold italic text-brand-dark shadow-sm">
                    Su método paso a paso te garantiza resultados profesionales, incluso si jamás en tu vida has hecho una manualidad.
                </div>
            </div>
        </div>
    </section>

    <!-- TESTIMONIOS (CARRUSEL) -->
    <section class="bg-brand-rose/5 py-24 px-6 overflow-hidden">
        <div class="max-w-6xl mx-auto relative">
            <h2 class="font-serif text-4xl text-center mb-4 text-brand-dark">Resultados 100% Reales de Nuestras Alumnas</h2>
            <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">Nada de testimonios inventados. Esto es lo que comparten las mujeres reales dentro de nuestra Comunidad VIP de WhatsApp todos los días.</p>
            
            <div class="relative group">
                <button id="prevBtn" class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 bg-white w-12 h-12 rounded-full shadow-xl items-center justify-center text-brand-sage hover:bg-brand-sage hover:text-white transition-all focus:outline-none" aria-label="Anterior">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <div id="testimonialSlider" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 pt-4 px-4 hide-scrollbar scroll-smooth">
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test3.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test1-1.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test2.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test7.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test8.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test10.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
                    <div class="snap-center shrink-0 w-[85vw] md:w-[350px] bg-white rounded-2xl p-2 shadow-md border border-gray-100 transform hover:-translate-y-1 transition-all"><img src="https://www.mentesmart.store/test11.webp" alt="Testimonio WhatsApp" class="w-full h-auto rounded-xl pointer-events-none" loading="lazy" /></div>
