---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arte de Calentamiento - Alquimia Natural</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Agregamos la librería html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        .font-serif { font-family: 'Playfair Display', serif; }
        .font-sans { font-family: 'Montserrat', sans-serif; }
    </style>
</head>
<body class="bg-gray-200 flex items-center justify-center min-h-screen p-4 flex-col gap-6">

    <!-- Botón Mágico de Descarga -->
    <button onclick="descargarImagen()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-6 rounded-full shadow-lg transition-transform transform hover:scale-105 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        Descargar JPG en Alta Calidad
    </button>

    <!-- Contenedor Principal (Agregamos id="arte-card" para que el script sepa qué recortar) -->
    <div id="arte-card" class="w-full max-w-[500px] aspect-square bg-[#FDFBF7] shadow-xl overflow-hidden flex flex-col border border-gray-200 relative">
        
        <!-- Título Principal (Arriba, centrado) -->
        <div class="pt-8 pb-4 px-6 text-center shrink-0">
             <h1 class="font-serif text-2xl md:text-3xl text-emerald-950 leading-tight">
                El poder de la <br>
                <span class="italic text-amber-700 font-semibold">Naturaleza</span> en tu piel 🌿
            </h1>
        </div>

        <!-- Contenedor de las Dos Columnas (Fotos Izq / Textos Der) -->
        <div class="flex flex-1 p-6 pt-2 gap-4">
            
            <!-- COLUMNA IZQUIERDA: Las dos imágenes -->
            <div class="w-2/5 flex flex-col gap-4">
                <!-- Imagen 1 (Ej: Avena / Jabón rústico) -->
                <div class="flex-1 rounded-2xl overflow-hidden shadow-sm border border-emerald-900/10">
                    <img src="https://images.unsplash.com/photo-1611078449925-f6c683863435?auto=format&fit=crop&q=80&w=400" alt="Ingredientes Naturales" class="w-full h-full object-cover">
                </div>
                <!-- Imagen 2 (Ej: Lavanda / Jabón suave) -->
                <div class="flex-1 rounded-2xl overflow-hidden shadow-sm border border-emerald-900/10">
                    <img src="https://images.unsplash.com/photo-1596433809252-260c27459d43?auto=format&fit=crop&q=80&w=400" alt="Jabón de Lavanda" class="w-full h-full object-cover">
                </div>
            </div>

            <!-- COLUMNA DERECHA: Los Textos alineados -->
            <div class="w-3/5 flex flex-col justify-around py-2 pl-2 pr-1">
                
                <!-- Texto 1 (Alineado con Imagen 1) -->
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-lg">🌾</span>
                        <strong class="font-sans text-emerald-900 text-sm md:text-base">El secreto de la Avena</strong>
                    </div>
                    <p class="font-sans text-gray-600 text-[12px] md:text-sm leading-relaxed">
                        Actúa como un exfoliante súper suave. Calma irritaciones y deja la piel como seda. Ideal para niños.
                    </p>
                </div>

                <!-- Línea separadora sutil -->
                <div class="w-full h-px bg-emerald-900/10 my-2"></div>

                <!-- Texto 2 (Alineado con Imagen 2) -->
                <div>
                     <div class="flex items-center gap-2 mb-1">
                        <span class="text-lg">💜</span>
                        <strong class="font-sans text-emerald-900 text-sm md:text-base">La paz de la Lavanda</strong>
                    </div>
                    <p class="font-sans text-gray-600 text-[12px] md:text-sm leading-relaxed">
                        Su aceite esencial puro no solo cuida tu piel, sino que transforma tu ducha en una terapia relajante anti-estrés.
                    </p>
                </div>

            </div>
        </div>

        <!-- Footer / Marca de Alquimia Natural -->
        <div class="text-center pb-5 pt-2 shrink-0">
            <p class="font-sans text-[10px] md:text-[11px] tracking-[0.2em] text-emerald-800 uppercase font-bold">
                @alquimia.natural
            </p>
        </div>

    </div>

    <!-- Script a mangbalbaliw iti JPG a nangato ti kalidadna -->
    <script>
        // En Astro, los scripts están encapsulados por defecto. 
        // Al asignar la función al objeto 'window', la hacemos global para que el botón 'onclick' la pueda ejecutar.
        (window as any).descargarImagen = function() {
            const card = document.getElementById('arte-card');
            const btn = document.querySelector('button');
            if (!btn) return;
            const originalText = btn.innerHTML;
            
            btn.innerHTML = 'Agparpartuat iti ladawan... ⏳';
            btn.disabled = true;
            
            // Usaren ti window.html2canvas tapno maliklikan ti TS error iti editor
            const html2canvasFn = (window as any).html2canvas || (window as any).html2canvas;
            
            if (typeof html2canvasFn !== 'undefined') {
                html2canvasFn(card, {
                    scale: 3, // Paaduen ti resolusion iti 3 para iti HD a kalidad
                    useCORS: true, // Palubosan ti panag-load kadagiti akin-ruar a ladawan
                    backgroundColor: '#FDFBF7'
                }).then((canvas: HTMLCanvasElement) => {
                    const link = document.createElement('a');
                    link.download = 'Alquimia_Natural_Arte.jpg';
                    link.href = canvas.toDataURL('image/jpeg', 0.95); // 95% a kalidad JPG
                    link.click(); // I-puersa ti panag-download
                    
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }).catch((err: Error) => {
                    alert("Adda biddut. Siguraduem nga adda nasayaat a koneksionmo iti internet.");
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                });
            } else {
                alert("Saan pay a nag-load ti html2canvas. Pangaasim ta agurayka bassit wenno i-refresh ti panid.");
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>