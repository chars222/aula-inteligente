---
import '../styles/global.css';
import PromptCard from '../components/PromptCard.astro';
import prompts1 from '../data/prompts.json';
import prompts2 from '../data/prompts2.json';
import prompts3 from '../data/prompts3.json';
import prompts4 from '../data/prompts4.json';
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Aula Inteligente | Domina la IA en el Aula</title>
</head>
<main class="max-w-4xl mx-auto p-12 bg-white min-h-screen font-sans">
  
  <header class="border-b-8 border-cyan-600 pb-8 mb-12 flex justify-between items-end">
    <div>
      <h1 class="text-5xl font-black text-slate-900 leading-none">100 PROMPTS <br/><span class="text-cyan-600">DE ORO</span></h1>
      <p class="mt-4 text-slate-500 font-medium">Guía Maestra para Docentes Innovadores 2026</p>
    </div>
    <div class="text-right">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Legado Tecnológico</p>
      <p class="text-sm font-bold text-cyan-600">Aula Inteligente</p>
    </div>
  </header>

  <h2 class="text-xl font-black text-white bg-slate-900 px-4 py-2 rounded-lg mb-8 inline-block">
    01. PLANIFICACIÓN ESTRATÉGICA
  </h2>

  <div class="space-y-4">
    {prompts1.map((p) => (
      <PromptCard 
        numero={p.numero} 
        titulo={p.titulo} 
        prompt={p.prompt} 
        categoria={p.categoria} 
      />
    ))}
  </div>

  <div class="mt-16 mb-8 border-t-2 border-slate-100 pt-8">
    <h2 class="text-xl font-black text-white bg-purple-600 px-4 py-2 rounded-lg mb-8 inline-block">
      Categoría 2: Especialidades
    </h2>
  </div>

   <div class="space-y-4">
    {prompts2.map((p) => (
      <PromptCard 
        numero={p.numero} 
        titulo={p.titulo} 
        prompt={p.prompt} 
      />
    ))}
  </div>

  <div class="mt-16 mb-8 border-t-2 border-slate-100 pt-8">
    <h2 class="text-xl font-black text-white bg-blue-950 px-4 py-2 rounded-lg mb-8 inline-block">
      Categoría 3: Canva + IA (Diseño Visual Inteligente)
    </h2>
  </div>

   <div class="space-y-4">
    {prompts3.map((p) => (
      <PromptCard 
        numero={p.numero} 
        titulo={p.titulo} 
        prompt={p.prompt} 
      />
    ))}
  </div>

   <div class="mt-16 mb-8 border-t-2 border-slate-100 pt-8">
    <h2 class="text-xl font-black text-white bg-blue-950 px-4 py-2 rounded-lg mb-8 inline-block">
      Categoría 4: Comunicación con Padres y Familias
    </h2>
  </div>

   <div class="space-y-4">
    {prompts4.map((p) => (
      <PromptCard 
        numero={p.numero} 
        titulo={p.titulo} 
        prompt={p.prompt} 
      />
    ))}
  </div>

  </main>

  <footer class="bg-slate-900 text-slate-400 py-12 px-6 text-center text-xs">
  <div class="max-w-3xl mx-auto space-y-4">
    <p>
      <strong>Aula Inteligente</strong> - Innovación Educativa 2026. Todos los derechos reservados.
    </p>
    <p>
      Este sitio web no es parte del sitio web de Facebook o Facebook Inc. Además, este sitio NO está respaldado por Facebook de ninguna manera. FACEBOOK es una marca registrada de FACEBOOK, Inc.
    </p>
    <p>
      <strong>Descargo de responsabilidad:</strong> Los resultados pueden variar de persona a persona. Las herramientas de IA y Canva son complementos para la labor docente y requieren aprendizaje y práctica.
    </p>
    <div class="flex justify-center gap-6 mt-4 underline">
      <a href="#">Políticas de Privacidad</a>
      <a href="#">Términos de Servicio</a>
      <a href="https://wa.me/TU_NUMERO">Contacto</a>
    </div>
  </div>
</footer>

<style>
  /* Optimizaciones para impresión a PDF */
  @media print {
    body { background-color: white !important; }
    .break-inside-avoid { page-break-inside: avoid; }
  }
</style>