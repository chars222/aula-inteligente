---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <!-- Cargamos el CDN de Tailwind con is:inline para asegurar que cargue antes de la configuración -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    
    <!-- IMPORTANTE: Usamos is:inline y una comprobación de seguridad para evitar el ReferenceError -->
    <script is:inline>
        // Inicializamos el objeto tailwind si el CDN aún no lo ha definido para evitar errores de referencia
        window.tailwind = window.tailwind || { config: {} };
        
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            sage: '#8A9A5B', // Verde Sabio
                            rose: '#D4A5A5', // Rosa Viejo
                            gold: '#C5A059', // Oro Mate
                            cream: '#FDFBF7', // Crema de fondo
                            dark: '#2D2D2D',  // Gris antracita para textos
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <title>Alquimia Natural | Emprende desde Casa</title>
</head>

<body class="bg-brand-cream text-brand-dark font-sans antialiased">

    <!-- BARRA DE URGENCIA -->
    <div class="bg-brand-rose text-white text-center py-2 px-4 text-sm font-semibold tracking-wide">
        ✨ OFERTA POR TIEMPO LIMITADO: 70% DE DESCUENTO DISPONIBLE HOY
    </div>

    <!-- HERO SECTION -->
    <section class="relative py-16 md:py-24 px-6 overflow-hidden">
        <div class="max-w-5xl mx-auto text-center relative z-10">
            <span class="text-brand-gold font-semibold tracking-[0.2em] uppercase text-sm mb-4 block italic underline decoration-brand-rose/30 underline-offset-4">Alquimia Natural</span>
            <h1 class="font-serif text-4xl md:text-6xl text-brand-dark leading-tight mb-8">
                Transforma tu pasión en <span class="italic text-brand-sage font-medium">libertad financiera</span> sin salir de casa.
            </h1>
            <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
                Aprende a crear jabones artesanales de lujo y construye un negocio rentable en 30 días, con una inversión menor a lo que cuesta una cena.
            </p>

            <div class="flex flex-col items-center gap-4">
                <a href="#oferta" class="bg-brand-sage hover:bg-brand-dark text-white px-12 py-5 rounded-full text-xl font-bold shadow-2xl transition-all transform hover:scale-105 active:scale-95">
                    SÍ, QUIERO EMPEZAR MI NEGOCIO
                </a>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span class="flex -space-x-2">
                        <div class="w-8 h-8 rounded-full bg-brand-rose border-2 border-brand-cream shadow-sm"></div>
                        <div class="w-8 h-8 rounded-full bg-brand-sage border-2 border-brand-cream shadow-sm"></div>
                        <div class="w-8 h-8 rounded-full bg-brand-gold border-2 border-brand-cream shadow-sm"></div>
                    </span>
                    <span>+1,200 alumnas ya están transformando su hogar</span>
                </div>
            </div>
        </div>
        
        <!-- Elementos decorativos orgánicos -->
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/4 w-96 h-96 bg-brand-rose opacity-10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/4 w-80 h-80 bg-brand-sage opacity-10 rounded-full blur-3xl"></div>
    </section>

    <!-- DOLOR / EMPATÍA -->
    <section class="py-20 bg-white px-6">
        <div class="max-w-4xl mx-auto">
            <h2 class="font-serif text-3xl md:text-4xl text-center mb-12">¿Sientes que el tiempo se te escapa entre el trabajo y la familia?</h2>
            
            <div class="grid md:grid-cols-2 gap-8">
                <div class="bg-brand-cream p-8 rounded-3xl border border-brand-rose/20 italic text-gray-700 shadow-sm transition-all hover:shadow-md">
                    "Quiero estar presente para mis hijos, pero no puedo depender de un solo sueldo que apenas alcanza para las cuentas."
                </div>
                <div class="bg-brand-cream p-8 rounded-3xl border border-brand-sage/20 italic text-gray-700 shadow-sm transition-all hover:shadow-md">
                    "Busco algo propio, algo que me apasione y que pueda escalar sin sacrificar mi tranquilidad ni invertir miles de dólares."
                </div>
            </div>
            
            <p class="mt-12 text-center text-lg font-medium text-brand-sage uppercase tracking-widest">
                Entendemos ese sentimiento. Por eso creamos Alquimia Natural.
            </p>
        </div>
    </section>

    <!-- EL SISTEMA (PASOS) -->
    <section class="py-24 px-6">
        <div class="max-w-6xl mx-auto text-center">
            <h2 class="font-serif text-4xl mb-16 underline decoration-brand-rose underline-offset-8">Tu camino a la independencia en 3 pasos</h2>
            
            <div class="grid md:grid-cols-3 gap-12">
                <!-- Paso 1 -->
                <div class="relative group">
                    <div class="mb-6 inline-block p-6 bg-white rounded-full shadow-xl group-hover:shadow-brand-sage/20 transition-all border border-brand-cream">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h3 class="font-serif text-2xl mb-4 text-brand-dark">1. Alquimia Creativa</h3>
                    <p class="text-gray-600 italic leading-relaxed">Domina técnicas artesanales para crear jabones que parecen joyas, con ingredientes naturales y aromas terapéuticos.</p>
                </div>

                <!-- Paso 2 -->
                <div class="relative group">
                    <div class="mb-6 inline-block p-6 bg-white rounded-full shadow-xl group-hover:shadow-brand-sage/20 transition-all border border-brand-cream">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <h3 class="font-serif text-2xl mb-4 text-brand-dark">2. Producción Consciente</h3>
                    <p class="text-gray-600 italic leading-relaxed">Te enseñamos a costear y fabricar en serie optimizando cada centavo para que tu margen de ganancia sea del 300%.</p>
                </div>

                <!-- Paso 3 -->
                <div class="relative group">
                    <div class="mb-6 inline-block p-6 bg-white rounded-full shadow-xl group-hover:shadow-brand-sage/20 transition-all border border-brand-cream">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="font-serif text-2xl mb-4 text-brand-dark">3. Ventas Magnéticas</h3>
                    <p class="text-gray-600 italic leading-relaxed">Usa Instagram y WhatsApp como tus mejores aliados. Aprende a tomar fotos que venden y a cerrar pedidos a diario.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="bg-brand-rose/5 py-24 px-6">
        <div class="max-w-5xl mx-auto">
            <h2 class="font-serif text-4xl text-center mb-16 italic text-brand-rose">Historias que inspiran</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-lg border-b-4 border-brand-rose transform hover:-translate-y-2 transition-all">
                    <p class="text-gray-600 italic mb-6">"Pude pagar la colegiatura de mis hijos solo con las ventas de mi primera semana. ¡No lo podía creer!"</p>
                    <p class="font-bold text-brand-dark">— María G.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-lg border-b-4 border-brand-sage transform hover:-translate-y-2 transition-all">
                    <p class="text-gray-600 italic mb-6">"Vendí mis primeros 150 dólares en Instagram sin saber nada de marketing. El curso es magia pura."</p>
                    <p class="font-bold text-brand-dark">— Laura P.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-lg border-b-4 border-brand-gold transform hover:-translate-y-2 transition-all">
                    <p class="text-gray-600 italic mb-6">"Tengo clientas fijas que me compran cada mes. Ya no dependo de nadie más."</p>
                    <p class="font-bold text-brand-dark">— Ana R.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- EL CURSO POR DENTRO -->
    <section class="py-24 px-6 bg-white text-brand-dark">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
            <div class="order-2 md:order-1">
                <div class="relative">
                    <div class="absolute inset-0 bg-brand-sage/20 rounded-3xl rotate-3"></div>
                    <!-- IMAGEN MOCKUP MEJORADA -->
                    <div class="relative bg-brand-cream rounded-3xl shadow-2xl overflow-hidden aspect-video flex items-center justify-center border-8 border-brand-dark px-10">
                         <span class="text-brand-gold font-serif italic text-2xl text-center">[Mockup del Curso Alquimia Natural]</span>
                    </div>
                </div>
            </div>
            <div class="order-1 md:order-2">
                <h2 class="font-serif text-4xl mb-8 leading-tight text-brand-dark">Una formación diseñada para resultados reales</h2>
                <ul class="space-y-6">
                    <li class="flex items-start gap-4">
                        <span class="bg-brand-sage/10 p-2 rounded-full text-brand-sage mt-1 italic font-bold">✔</span>
                        <div>
                            <p class="font-bold text-lg">70+ Lecciones en Video HD</p>
                            <p class="text-sm text-gray-500">Aprende a tu ritmo, con acceso de por vida.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="bg-brand-sage/10 p-2 rounded-full text-brand-sage mt-1 italic font-bold">✔</span>
                        <div>
                            <p class="font-bold text-lg">Recetarios y Guías PDF</p>
                            <p class="text-sm text-gray-500">Material descargable para tener en tu mesa de trabajo.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="bg-brand-sage/10 p-2 rounded-full text-brand-sage mt-1 italic font-bold">✔</span>
                        <div>
                            <p class="font-bold text-lg">Módulo VIP de Ventas</p>
                            <p class="text-sm text-gray-500">Cómo crear tu marca y conseguir clientes sin pagar publicidad.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- OFERTA FINAL -->
    <section id="oferta" class="py-24 px-6 bg-brand-cream relative">
        <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-[3rem] shadow-2xl overflow-hidden border border-brand-gold/20">
                <div class="bg-brand-dark py-8 text-center px-6">
                    <h2 class="font-serif text-3xl text-white italic">Únete a Alquimia Natural hoy</h2>
                    <p class="text-brand-gold font-medium mt-2 tracking-widest uppercase text-xs">Todo el curso + 2 Bonos Exclusivos</p>
                </div>
                
                <div class="p-10 text-center">
                    <div class="mb-8">
                        <span class="text-gray-400 line-through text-2xl font-light">$100.00 USD</span>
                        <div class="text-6xl md:text-7xl font-bold text-brand-sage mt-2">$30.00 <span class="text-2xl">USD</span></div>
                        <p class="text-brand-rose font-bold mt-4 animate-pulse">⚠️ PRECIO CON CUPÓN ACTIVO: -70%</p>
                    </div>

                    <div class="space-y-4 mb-10 text-left bg-brand-cream p-6 rounded-2xl border border-dashed border-brand-rose">
                        <p class="flex items-center gap-3">🎁 <strong>Bono 1:</strong> Plantilla de Costos (Valor $27)</p>
                        <p class="flex items-center gap-3">🎁 <strong>Bono 2:</strong> Guía de Ventas WhatsApp (Valor $37)</p>
                    </div>

                    <a href="https://go.hotmart.com/V104688154N?ap=9d09" class="block w-full bg-brand-sage hover:bg-brand-dark text-white py-6 rounded-2xl text-2xl font-black shadow-xl transition-all mb-6 transform hover:scale-[1.01] active:scale-[0.98]">
                        SÍ, QUIERO ACCESO INMEDIATO
                    </a>

                    <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-500">
                        <span class="flex items-center gap-1">🛡️ 7 días de garantía</span>
                        <span class="flex items-center gap-1">🔒 Pago 100% seguro</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-16 bg-white text-center border-t border-brand-rose/10">
        <p class="font-serif text-2xl italic text-brand-rose mb-2">Alquimia Natural</p>
        <p class="text-xs text-brand-gold font-semibold tracking-widest uppercase mb-4">Transformación • Belleza • Libertad</p>
        <p class="text-[10px] text-gray-400 max-w-lg mx-auto leading-relaxed px-6">© 2026 Alquimia Natural. Todos los derechos reservados. Este sitio no es parte de Facebook o Google. Las ganancias mencionadas son resultados de alumnas reales pero dependen del esfuerzo individual.</p>
    </footer>

</body>
</html>
